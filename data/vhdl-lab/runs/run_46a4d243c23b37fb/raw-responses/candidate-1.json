  "response": "```vhdl\nlibrary ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\n\nentity mini_cpu_core_top is\n    generic (\n        DATA_WIDTH : positive := 8\n    );\n    port (\n        clk         : in  std_logic;\n        rst         : in  std_logic;\n        pm_addr_o   : out unsigned(7 downto 0);\n        pm_data_i   : in  std_logic_vector(7 downto 0);\n        dm_addr_o   : out unsigned(7 downto 0);\n        dm_wdata_o  : out std_logic_vector(7 downto 0);\n        dm_rdata_i  : in  std_logic_vector(7 downto 0);\n        dm_we_o     : out std_logic;\n        halted_o    : out std_logic;\n        status_o    : out std_logic_vector(7 downto 0)\n    );\nend entity mini_cpu_core_top;\n\narchitecture rtl of mini_cpu_core_top is\n\n    -- Define the custom 8-bit ISA\n    type instruction_t is record\n        opcode : std_logic_vector(3 downto 0);\n        rd     : std_logic_vector(2 downto 0);\n        rs1    : std_logic_vector(2 downto 0);\n        rs2    : std_logic_vector(2 downto 0);\n        imm    : signed(DATA_WIDTH-1 downto 0);\n    end record instruction_t;\n\n    -- Define the register file\n    type reg_file_t is array (natural range <>) of std_logic_vector(DATA_WIDTH-1 downto 0);\n\n    -- Signals for internal use\n    signal pc_reg          : unsigned(7 downto 0) := (others => '0');\n    signal instruction     : instruction_t;\n    signal reg_file        : reg_file_t(0 to 7);\n    signal alu_result      : std_logic_vector(DATA_WIDTH-1 downto 0);\n    signal write_back_data : std_logic_vector(DATA_WIDTH-1 downto 0);\n    signal write_back_reg  : natural range 0 to 7;\n    signal write_back_en   : std_logic;\n\nbegin\n\n    -- Instruction Fetch\n    pm_addr_o <= pc_reg;\n\n    fetch_process : process(clk, rst)\n    begin\n        if rst = '1' then\n            pc_reg <= (others => '0');\n        elsif rising_edge(clk) then\n            pc_reg <= pc_reg + 1;\n        end if;\n    end process fetch_process;\n\n    -- Instruction Decode\n    decode_process : process(instruction)\n    begin\n        case instruction.opcode is\n            when \"0000\" => -- ADD rd, rs1, rs2\n                alu_result <= std_logic_vector(signed(reg_file(to_integer(unsigned(instruction.rs1))) + signed(reg_file(to_integer(unsigned(instruction.rs2)))));\n                write_back_reg <= to_integer(unsigned(instruction.rd));\n                write_back_en  <= '1';\n            when \"0001\" => -- SUB rd, rs1, rs2\n                alu_result <= std_logic_vector(signed(reg_file(to_integer(unsigned(instruction.rs1))) - signed(reg_file(to_integer(unsigned(instruction.rs2)))));\n                write_back_reg <= to_integer(unsigned(instruction.rd));\n                write_back_en  <= '1';\n            when \"0010\" => -- AND rd, rs1, rs2\n                alu_result <= reg_file(to_integer(unsigned(instruction.rs1))) and reg_file(to_integer(unsigned(instruction.rs2)));\n                write_back_reg <= to_integer(unsigned(instruction.rd));\n                write_back_en  <= '1';\n            when \"0011\" => -- OR rd, rs1, rs2\n                alu_result <= reg_file(to_integer(unsigned(instruction.rs1))) or reg_file(to_integer(unsigned(instruction.rs2)));\n                write_back_reg <= to_integer(unsigned(instruction.rd));\n                write_back_en  <= '1';\n            when \"0100\" => -- XOR rd, rs1, rs2\n                alu_result <= reg_file(to_integer(unsigned(instruction.rs1))) xor reg_file(to_integer(unsigned(instruction.rs2)));\n                write_back_reg <= to_integer(unsigned(instruction.rd));\n                write_back_en  <= '1';\n            when \"0101\" => -- SLT rd, rs1, rs2\n                if signed(reg_file(to_integer(unsigned(instruction.rs1)))) < signed(reg_file(to_integer(unsigned(instruction.rs2)))) then\n                    alu_result <= (others => '0');\n                    alu_result(0) <= '1';\n                else\n                    alu_result <= (others => '0');\n                end if;\n                write_back_reg <= to_integer(unsigned(instruction.rd));\n                write_back_en  <= '1';\n            when \"0110\" => -- SLL rd, rs1, imm\n                alu_result <= std_logic_vector(shift_left(unsigned(reg_file(to_integer(unsigned(instruction.rs1)))), to_integer(unsigned(instruction.imm))));\n                write_back_reg <= to_integer(unsigned(instruction.rd));\n                write_back_en  <= '1';\n            when \"0111\" => -- SRL rd, rs1, imm\n                alu_result <= std_logic_vector(shift_right(unsigned(reg_file(to_integer(unsigned(instruction.rs1)))), to_integer(unsigned(instruction.imm))));\n                write_back_reg <= to_integer(unsigned(instruction.rd));\n                write_back_en  <= '1';\n            when \"1000\" => -- ADDI rd, rs1, imm\n                alu_result <= std_logic_vector(signed(reg_file(to_integer(unsigned(instruction.rs1))) + instruction.imm));\n                write_back_reg <= to_integer(unsigned(instruction.rd));\n                write_back_en  <= '1';\n            when \"1001\" => -- ANDI rd, rs1, imm\n                alu_result <= reg_file(to_integer(unsigned(instruction.rs1))) and std_logic_vector(instruction.imm);\n                write_back_reg <= to_integer(unsigned(instruction.rd));\n                write_back_en  <= '1';\n            when \"1010\" => -- ORI rd, rs1, imm\n                alu_result <= reg_file(to_integer(unsigned(instruction.rs1))) or std_logic_vector(instruction.imm);\n                write_back_reg <= to_integer(unsigned(instruction.rd));\n                write_back_en  <= '1';\n            when \"1011\" => -- XORI rd, rs1, imm\n                alu_result <= reg_file(to_integer(unsigned(instruction.rs1))) xor std_logic_vector(instruction.imm);\n                write_back_reg <= to_integer(unsigned(instruction.rd));\n                write_back_en  <= '1';\n            when \"1100\" => -- SLTI rd, rs1, imm\n                if signed(reg_file(to_integer(unsigned(instruction.rs1)))) < instruction.imm then\n                    alu_result <= (others => '0');\n                    alu_result(0) <= '1';\n                else\n                    alu_result <= (others => '0');\n                end if;\n                write_back_reg <= to_integer(unsigned(instruction.rd));\n                write_back_en  <= '1';\n            when \"1101\" => -- SLLI rd, rs1, imm\n                alu_result <= std_logic_vector(shift_left(unsigned(reg_file(to_integer(unsigned(instruction.rs1)))), to_integer(unsigned(instruction.imm))));\n                write_back_reg <= to_integer(unsigned(instruction.rd));\n                write_back_en  <= '1';\n            when \"1110\" => -- SRLI rd, rs1, imm\n                alu_result <= std_logic_vector(shift_right(unsigned(reg_file(to_integer(unsigned(instruction.rs1)))), to_integer(unsigned(instruction.imm))));\n                write_back_reg <= to_integer(unsigned(instruction.rd));\n                write_back_en  <= '1';\n            when others =>\n                alu_result     <= (others => '0');\n                write_back_reg <= 0;\n                write_back_en  <= '0';\n        end case;\n    end process decode_process;\n\n    -- Register File\n    reg_file_process : process(clk, rst)\n    begin\n        if rst = '1' then\n            for i in 0 to 7 loop\n                reg_file(i) <= (others => '0');\n            end loop;\n        elsif rising_edge(clk) then\n            if write_back_en = '1' then\n                reg_file(write_back_reg) <= write_back_data;\n            end if;\n        end if;\n    end process reg_file_process;\n\n    -- Write Back\n    write_back_data <= alu_result;\n\n    -- Data Memory Interface\n    dm_addr_o   <= unsigned(reg_file(0));\n    dm_wdata_o  <= reg_file(1);\n    dm_we_o     <= '0'; -- No writes to data memory in this example\n\n    -- Halted and Status Signals\n    halted_o <= '0';\n    status_o <= (others => '0');\n\nend architecture rtl;\n```",
