  "response": "library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\n\nentity video_pattern_generator_top is\n  generic (\n    DATA_WIDTH : positive := 8\n  );\n  port (\n    clk : in std_logic;\n    rst : in std_logic;\n    hsync_o : out std_logic;\n    vsync_o : out std_logic;\n    de_o : out std_logic;\n    pixel_o : out std_logic_vector(23 downto 0);\n    pixel_addr_o : out unsigned(18 downto 0)\n  );\nend entity video_pattern_generator_top;\n\nlibrary ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\n\narchitecture rtl of video_pattern_generator_top is\n\n    -- VGA Timing Constants\n    constant H_ACTIVE   : natural := 640;\n    constant H_FRONT_PORCH : natural := 16;\n    constant H_SYNC_PULSE : natural := 96;\n    constant H_BACK_PORCH : natural := 48;\n\n    constant V_ACTIVE   : natural := 480;\n    constant V_FRONT_PORCH : natural := 10;\n    constant V_SYNC_PULSE : natural := 2;\n    constant V_BACK_PORCH : natural := 33;\n\n    -- Horizontal and Vertical Counters\n    signal h_count : unsigned(9 downto 0) := (others => '0');\n    signal v_count : unsigned(9 downto 0) := (others => '0');\n\n    -- Sync Signals\n    signal hsync_i : std_logic;\n    signal vsync_i : std_logic;\n\n    -- Active Video Window Signal\n    signal de_i : std_logic;\n\nbegin\n\n    -- Horizontal Timing Counter\n    process(clk, rst)\n    begin\n        if rising_edge(clk) then\n            if rst = '1' then\n                h_count <= (others => '0');\n            else\n                if h_count = H_ACTIVE + H_FRONT_PORCH + H_SYNC_PULSE + H_BACK_PORCH - 1 then\n                    h_count <= (others => '0');\n                else\n                    h_count <= h_count + 1;\n                end if;\n            end if;\n        end if;\n    end process;\n\n    -- Vertical Timing Counter\n    process(clk, rst)\n    begin\n        if rising_edge(clk) then\n            if rst = '1' then\n                v_count <= (others => '0');\n            else\n                if h_count = H_ACTIVE + H_FRONT_PORCH + H_SYNC_PULSE + H_BACK_PORCH - 1 then\n                    if v_count = V_ACTIVE + V_FRONT_PORCH + V_SYNC_PULSE + V_BACK_PORCH - 1 then\n                        v_count <= (others => '0');\n                    else\n                        v_count <= v_count + 1;\n                    end if;\n                end if;\n            end if;\n        end if;\n    end process;\n\n    -- Sync Generation Logic\n    hsync_i <= '0' when h_count >= H_ACTIVE + H_FRONT_PORCH and h_count < H_ACTIVE + H_FRONT_PORCH + H_SYNC_PULSE else '1';\n    vsync_i <= '0' when v_count >= V_ACTIVE + V_FRONT_PORCH and v_count < V_ACTIVE + V_FRONT_PORCH + V_SYNC_PULSE else '1';\n\n    -- Active-Video Window Generation\n    de_i <= '1' when h_count < H_ACTIVE and v_count < V_ACTIVE else '0';\n\n    -- Pixel Addressing Path (Framebuffer-style)\n    pixel_addr_o <= to_unsigned((to_integer(v_count) * H_ACTIVE) + to_integer(h_count), pixel_addr_o'length)\n                    when de_i = '1' else (others => '0');\n\n    -- Pattern Generator or Pixel Formatting Stage\n    process(clk, rst)\n        variable pixel_value : std_logic_vector(23 downto 0);\n    begin\n        if rising_edge(clk) then\n            if rst = '1' then\n                pixel_o <= (others => '0');\n            else\n                if de_i = '1' then\n                    -- Simple pattern: horizontal gradient\n                    pixel_value := std_logic_vector(h_count(7 downto 0)) & std_logic_vector(h_count(7 downto 0)) & std_logic_vector(h_count(7 downto 0));\n                    pixel_o <= pixel_value;\n                else\n                    pixel_o <= (others => '0');\n                end if;\n            end if;\n        end if;\n    end process;\n\n    -- Top-Level Video Output Integration\n    hsync_o <= hsync_i;\n    vsync_o <= vsync_i;\n    de_o    <= de_i;\n\nend architecture rtl;",
