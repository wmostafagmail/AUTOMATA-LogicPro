  "response": "library ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\n\nentity mini_cpu_core_top is\n  generic (\n    DATA_WIDTH : positive := 8\n  );\n  port (\n    clk : in std_logic;\n    rst : in std_logic;\n    pm_addr_o : out unsigned(7 downto 0);\n    pm_data_i : in std_logic_vector(7 downto 0);\n    dm_addr_o : out unsigned(7 downto 0);\n    dm_wdata_o : out std_logic_vector(7 downto 0);\n    dm_rdata_i : in std_logic_vector(7 downto 0);\n    dm_we_o : out std_logic;\n    halted_o : out std_logic;\n    status_o : out std_logic_vector(7 downto 0)\n  );\nend entity mini_cpu_core_top;\n\narchitecture rtl of mini_cpu_core_top is\n\n    -- Define the instruction set architecture (ISA) for this CPU\n    -- This example uses a simple custom 8-bit ISA with the following instructions:\n    -- 0x00: NOP\n    -- 0x1X: LOAD Rn, [addr]\n    -- 0x2X: STORE Rn, [addr]\n    -- 0x3X: ADD Rn, Rm\n    -- 0x4X: SUB Rn, Rm\n    -- 0x5X: AND Rn, Rm\n    -- 0x6X: OR Rn, Rm\n    -- 0x7X: XOR Rn, Rm\n    -- 0x8X: CMP Rn, Rm\n    -- 0x9X: JMP addr\n    -- 0xA0: HALT\n\n    type reg_file_type is array (natural range <>) of std_logic_vector(DATA_WIDTH-1 downto 0);\n    signal reg_file : reg_file_type(0 to 7) := (others => (others => '0'));\n\n    signal pc          : unsigned(7 downto 0) := (others => '0');\n    signal instruction : std_logic_vector(7 downto 0);\n\n    type state_type is (FETCH, DECODE, EXECUTE);\n    signal current_state : state_type := FETCH;\n\nbegin\n\n    -- Program Memory Interface\n    pm_addr_o <= pc;\n\n    -- Data Memory Interface\n    dm_we_o   <= '1' when instruction(7 downto 4) = \"0010\" else '0';\n\n    -- Control Unit (FSM)\n    process(clk, rst)\n    begin\n        if rst = '1' then\n            pc          <= (others => '0');\n            current_state <= FETCH;\n            halted_o    <= '0';\n            status_o    <= (others => '0');\n        elsif rising_edge(clk) then\n            case current_state is\n                when FETCH =>\n                    instruction <= pm_data_i;\n                    pc          <= pc + 1;\n                    current_state <= DECODE;\n\n                when DECODE =>\n                    current_state <= EXECUTE;\n\n                when EXECUTE =>\n                    case instruction(7 downto 4) is\n                        when \"0000\" => -- NOP\n                            null;\n\n                        when \"0001\" => -- LOAD Rn, [addr]\n                            reg_file(to_integer(unsigned(instruction(3 downto 0)))) <= dm_rdata_i;\n\n                        when \"0010\" => -- STORE Rn, [addr]\n                            dm_addr_o <= unsigned(reg_file(to_integer(unsigned(instruction(3 downto 0)))));\n\n                        when \"0011\" => -- ADD Rn, Rm\n                            reg_file(to_integer(unsigned(instruction(3 downto 2) & '0'))) <= std_logic_vector(\n                                unsigned(reg_file(to_integer(unsigned(instruction(3 downto 2) & '0')))) +\n                                unsigned(reg_file(to_integer(unsigned(instruction(1 downto 0))))));\n\n                        when \"0100\" => -- SUB Rn, Rm\n                            reg_file(to_integer(unsigned(instruction(3 downto 2) & '0'))) <= std_logic_vector(\n                                unsigned(reg_file(to_integer(unsigned(instruction(3 downto 2) & '0')))) -\n                                unsigned(reg_file(to_integer(unsigned(instruction(1 downto 0))))));\n\n                        when \"0101\" => -- AND Rn, Rm\n                            reg_file(to_integer(unsigned(instruction(3 downto 2) & '0'))) <=\n                                reg_file(to_integer(unsigned(instruction(3 downto 2) & '0'))) and\n                                reg_file(to_integer(unsigned(instruction(1 downto 0))));\n\n                        when \"0110\" => -- OR Rn, Rm\n                            reg_file(to_integer(unsigned(instruction(3 downto 2) & '0'))) <=\n                                reg_file(to_integer(unsigned(instruction(3 downto 2) & '0'))) or\n                                reg_file(to_integer(unsigned(instruction(1 downto 0))));\n\n                        when \"0111\" => -- XOR Rn, Rm\n                            reg_file(to_integer(unsigned(instruction(3 downto 2) & '0'))) <=\n                                reg_file(to_integer(unsigned(instruction(3 downto 2) & '0'))) xor\n                                reg_file(to_integer(unsigned(instruction(1 downto 0))));\n\n                        when \"1000\" => -- CMP Rn, Rm\n                            if unsigned(reg_file(to_integer(unsigned(instruction(3 downto 2) & '0')))) =\n                               unsigned(reg_file(to_integer(unsigned(instruction(1 downto 0))))) then\n                                status_o <= X\"FF\";\n                            else\n                                status_o <= (others => '0');\n                            end if;\n\n                        when \"1001\" => -- JMP addr\n                            pc <= unsigned(instruction(3 downto 0) & instruction(7 downto 4));\n\n                        when \"1010\" => -- HALT\n                            halted_o <= '1';\n\n                        when others =>\n                            null;\n                    end case;\n\n                    current_state <= FETCH;\n            end case;\n        end if;\n    end process;\n\nend architecture rtl;",
